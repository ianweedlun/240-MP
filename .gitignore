# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# 240-MP #
######################
/build
/build-*
/.cache
build-*/
# ...but not our own composite action: `.github/actions/build-and-test/` is a
# source path, not a build output. Without these negations git ignores the
# whole directory and every workflow referencing it ships broken CI.
!.github/actions/
!.github/actions/build-and-test/
!.github/actions/build-and-test/**
*.local.bak/
# AppImage build outputs (scripts/build-appimage.sh, scripts/build-mpv.sh)
/AppDir
/.appimage-tools
/.mpv-build
/*.AppImage

devbuild/
.local-build-*/

# Secrets and agent scratch state — never commit credentials or sweep live worktrees
######################
id_*
*.pem
*.key
*.p12
.env
.env.*
!.env.example
*.token
auth-token
credentials.json
.worktrees/
