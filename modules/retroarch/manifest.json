{
  "id": "com.240mp.retroarch",
  "name": "RETROARCH",
  "icon": "assets/images/logo.svg",
  "entry_point_qml": "views/Root.qml",
  "settings": [
    {
      "key": "enabled",
      "label": "Enabled",
      "type": "toggle",
      "default": "OFF",
      "description": "Show RETROARCH on the main menu."
    },
    {
      "key": "playlist_directory",
      "label": "Playlist Folder",
      "type": "directory_browser",
      "default": "",
      "description": "Default: ~/.config/retroarch/playlists"
    },
    {
      "key": "rom_directory",
      "label": "ROM Folder",
      "type": "directory_browser",
      "default": "",
      "description": "Default: ~/ROMs"
    },
    {
      "key": "thumbnail_directory",
      "label": "Thumbnail Folder",
      "type": "directory_browser",
      "default": "",
      "description": "Default: ~/.config/retroarch/thumbnails"
    },
    {
      "key": "thumbnail_display",
      "label": "Thumbnail Display",
      "type": "list_single",
      "default": "RIGHT",
      "options": [
        "OFF",
        "LEFT",
        "RIGHT"
      ]
    },
    {
      "key": "retroarch_path",
      "label": "RetroArch Executable",
      "type": "directory_browser",
      "default": "",
      "description": "Default: retroarch in PATH"
    },
    {
      "key": "playlist_sort",
      "label": "Playlist Sort",
      "type": "list_single",
      "default": "SYSTEM",
      "options": [
        "SYSTEM",
        "COMPANY"
      ],
      "description": "[SYSTEM] Alpha by shortname [COMPANY] Sort by company"
    }
  ]
}