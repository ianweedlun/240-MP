{
  "id": "com.240mp.youtube",
  "name": "YouTube",
  "icon": "assets/images/logo.svg",
  "version": "1.0",
  "entry_point_qml": "views/Root.qml",

  "settings": [
    {
      "key": "enabled",
      "label": "Enabled",
      "type": "toggle",
      "default": "OFF"
    },
    {
      "key": "playback_resolution",
      "label": "Playback Resolution",
      "type": "list_single",
      "options": ["480p", "720p", "1080p"],
      "default": "480p"
    },
    {
      "key": "resume_playback",
      "label": "Resume Playback",
      "type": "list_single",
      "options": ["Ask", "Always"],
      "default": "Ask"
    },
    {
      "key": "autoplay_playlist_items",
      "label": "Autoplay Playlist Items",
      "type": "toggle",
      "default": "OFF",
      "description": "Automatically play the next item in the playlist when the current one ends."
    },
    {
      "key": "display_shorts",
      "label": "Display Shorts",
      "type": "toggle",
      "default": "ON"
    },
    {
      "key": "device_sign_in",
      "label": "Sign In on YouTube (TV Pairing)",
      "type": "action",
      "action_slot": "startDeviceSignIn",
      "description": "Sign in with the TV flow: an 8-char code appears on screen; type it at the shown URL on any device. Grants account subscriptions, history and watch-later; signing out restores the file-based lists."
    },
    {
      "key": "device_pair_cancel",
      "label": "Cancel Pairing",
      "type": "action",
      "action_slot": "cancelDeviceSignIn"
    },
    {
      "key": "device_sign_out",
      "label": "Sign Out of YouTube",
      "type": "action",
      "action_slot": "deviceSignOut"
    },
    {
      "key": "delete_watch_later",
      "label": "Delete Watch Later",
      "type": "action",
      "action_slot": "delete_watch_later"
    },
    {
      "key": "delete_history",
      "label": "Delete History",
      "type": "action",
      "action_slot": "delete_history"
    }
  ]
}
